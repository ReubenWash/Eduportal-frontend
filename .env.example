VITE_API_URL=http://localhost:5000/api/v1
VITE_TENANT_ROOT_DOMAIN=

# Firebase Web App config from Project settings → General → Your apps → Web app.
# The VAPID key is under Project settings → Cloud Messaging → Web Push certificates.
# These are public client identifiers; never put service-account keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
